# Mỗi dòng một token Apify; dùng theo thứ tự, tự chuyển khi token lỗi/hết quota.
APIFY_TOKENS=
UPPROMOTE_API_URL=
UPPROMOTE_BEARER_TOKEN=
UPPROMOTE_SESSION=
UPPROMOTE_REFRESH_TOKEN=
UPPROMOTE_EMAIL=
# Mật khẩu Uppromote:
#   - dpapi:... = mã hóa Windows, CHỈ dùng trên đúng máy đã mã hóa (copy sang máy khác sẽ lỗi)
#   - plain text = copy được sang máy khác; tool tự mã hóa dpapi khi chạy (trừ khi có UPPROMOTE_SKIP_DPAPI=1)
#   python scripts/encrypt_uppromote_password.py
UPPROMOTE_PASSWORD=
# Đặt 1 nếu copy .env sang nhiều máy và giữ mật khẩu plain (không tự mã hóa dpapi)
UPPROMOTE_SKIP_DPAPI=
UPPROMOTE_CDP_URL=http://127.0.0.1:9501
# Edge Uppromote khi auto-login: 1=headless ẩn (mặc định), 0=hiện cửa sổ, offscreen=đẩy ra ngoài màn hình
UPPROMOTE_EDGE_HIDDEN=1
UPPROMOTE_PER_PAGE=50
# Giới hạn số brand (record API) mỗi lần lọc cho Uppromote/Goaffpro/Refersion
# Tăng lên sẽ tăng số dữ liệu tải từ API trước khi chạy Apify.
UPPROMOTE_GOAFFPRO_REFERSION_MAX_BRANDS_PER_RUN=200
GOAFFPRO_API_URL=https://api-server-3.goaffpro.com/v1/public/sites?keyword=&country=&currency=&category=
GOAFFPRO_BEARER_TOKEN=
GOAFFPRO_LIMIT=50

# License server (Laravel) deploy riêng
AFF_LICENSE_API_BASE_URL=https://license.your-domain.com
AFF_LICENSE_API_TOKEN=
AFF_LICENSE_DAILY_LIMIT=500
